// datui in the Omarchy menu.
//
// Merge these entries into ~/.config/omarchy/extensions/omarchy-menu.jsonc
// (that file is one JSONC object; add these keys to it).
//
// WHY TWO ENTRIES
//
// "Explore" focuses an already-running datui. Asking for "a datui" when one is
// already open almost always means you want the one you have — and Ctrl+O inside it
// reaches any other dataset anyway, so nothing is lost.
//
// "New window" always starts a fresh instance, for the case that focusing would
// ruin: you are working in one dataset and want a second one beside it to compare.
//
// The same rule applies to any row you add that names a specific dataset. A targeted
// row should always open a new window, because naming a dataset means you want *that*
// one, not whatever is currently loaded.
//
// Only the parent row carries an icon, so it lines up with the rest of the root menu;
// the children go without. Decorating every row is noise. Drop the icon entirely if
// you would rather — the menu handles a missing one fine.
//
// datui's own interface uses no Nerd Font characters at all, and falls back to plain
// ASCII on terminals that are not running a UTF-8 locale.
{
  "data": {
    "icon": "󰆼",
    "label": "Data",
    "aliases": ["data", "datui", "datasets", "parquet", "csv"],
    "description": "Explore datasets - recent, configured directories, and here",
    "when": "command -v datui"
  },

  "data.explore": {
    "label": "Explore",
    "aliases": ["explore", "browse data"],
    "description": "Open datui, or focus the one already running",
    "action": "omarchy-launch-or-focus-tui datui"
  },

  "data.new": {
    "label": "New window",
    "aliases": ["new datui", "compare data"],
    "description": "A second datui, for comparing against what you have open",
    "action": "omarchy-launch-tui datui"
  }

  // A dataset you open often. Targeted rows always open a new window, so this never
  // replaces what you are already looking at.
  // ,"data.warehouse": {
  //   "icon": "󰉋",
  //   "label": "Warehouse",
  //   "description": "/mnt/data/warehouse",
  //   "action": "omarchy-launch-tui bash -c 'cd /mnt/data/warehouse && exec datui'"
  // }
}
