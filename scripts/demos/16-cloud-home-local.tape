Output demos/16-cloud-home-local.gif
Set FontSize 14
Set Width 1200
Set Height 800
Set TypingSpeed 25ms
# DO NOT DELETE - HEADER ABOVE

# Local-first variation: recents and files, then the public cloud catalog.
Hide
Type "cd /tmp/datui-demo/data"
Enter
Type "clear"
Enter
Show

Type "datui"
Enter
Sleep 3s
Down
Sleep 1s
Down
Sleep 1s
Down
Sleep 1.5s

Type "weather"
Sleep 1.5s
Enter
Sleep 4s
Down
Down
Down
Down
Sleep 2s

Ctrl+O
Sleep 3s
Ctrl+U
Sleep 1s
Type "public"
Sleep 1.5s
Enter
Sleep 2s
Type "noaa"
Sleep 1.5s
Enter
Sleep 6s

Ctrl+Q
