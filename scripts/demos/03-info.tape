Output demos/03-info.gif
Set FontSize 18
Set Width 1200
Set Height 800
Set TypingSpeed 25ms
# DO NOT DELETE - HEADER ABOVE
Hide
# Every orbital launch attempt since Sputnik, from Jonathan McDowell's GCAT.
Type "datui demo/data/space_launches.parquet"
Enter
Sleep 0.8s
Show
Sleep 1s

# Open the info panel.
Type "i"
Sleep 1s

# Scroll the schema.
Type "j"
Sleep 0.1s
Type "j"
Sleep 0.1s
Type "j"
Sleep 0.1s
Type "j"
Sleep 0.1s
Type "k"
Sleep 0.1s
Type "k"
Sleep 0.1s
Type "k"
Sleep 0.1s
Type "k"
Sleep 1s

# Over to the resources tab.
Tab
Sleep 1s
Type "l"
Sleep 5s
Escape
Sleep 1s
