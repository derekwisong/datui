# The one look every capture shares. capture.py puts this ahead of each tape,
# after the Output lines; a tape holds no Set lines of its own.
# 120 x 32 cells at 18 px. Tokyo Night under night-market, so the padding
# matches the theme's own background.
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 18
Set Width 1376
Set Height 788
Set Padding 12
Set Margin 0
Set BorderRadius 0
Set TypingSpeed 40ms
Set WaitTimeout 90s
Set Theme { "name": "Tokyo Night", "background": "#1a1b26", "foreground": "#c0caf5", "cursor": "#c0caf5", "selection": "#283457", "black": "#15161e", "red": "#f7768e", "green": "#9ece6a", "yellow": "#e0af68", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#7dcfff", "white": "#a9b1d6", "brightBlack": "#414868", "brightRed": "#f7768e", "brightGreen": "#9ece6a", "brightYellow": "#e0af68", "brightBlue": "#7aa2f7", "brightMagenta": "#bb9af7", "brightCyan": "#7dcfff", "brightWhite": "#c0caf5" }
