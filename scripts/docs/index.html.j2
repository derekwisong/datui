<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
{# generated: format-count #}
{% set format_count = 27 %}
{% set format_sentence = "datui reads 27 formats: Parquet, CSV, TSV, PSV, JSON, NDJSON, Arrow IPC, Avro, ORC, Excel, SafeTensors, GGUF, NMEA, GPX, WAV/AIFF audio, MIDI, SQLite, VCD, FIX, SDF, NumPy, ELF, ULog, DataFlash, candump, plain text, systemd journal, and binary formats you describe in a format spec." %}
{# end generated: format-count #}
  <meta name="description" content="Explore tabular data in your terminal: {{ format_count }} formats, on disk or in S3, GCS, Azure and HTTP. Query with SQL, chart and export.">
  <meta name="theme-color" content="#1a1b26">
  <title>datui — Explore tabular data in your terminal</title>
  <script>
    document.documentElement.classList.add('js');
    try {
      const theme = localStorage.getItem('datui-theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    } catch (_) { /* System colors still work when storage is unavailable. */ }
  </script>
  <style>
    :root {
      color-scheme: light;
      --bg: #f7f8fc; --panel: #edf0f7; --text: #252b42; --muted: #57617b;
      --accent: #186183; --line: #d6dce8;
      --mono: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #1a1b26; --panel: #202334; --text: #c0caf5; --muted: #a9b1d6;
      --accent: #7dcfff; --line: #373d55;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        color-scheme: dark;
        --bg: #1a1b26; --panel: #202334; --text: #c0caf5; --muted: #a9b1d6;
        --accent: #7dcfff; --line: #373d55;
      }
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.65 system-ui, sans-serif; }
    a { color: var(--accent); text-underline-offset: .2em; }
    a:hover { text-decoration-thickness: 2px; }
    :focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
    button, summary { cursor: pointer; }
    button { font: inherit; color: inherit; }
    .wrap { width: min(1120px, 100% - 48px); margin-inline: auto; }
    header { display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; align-items: center; padding: 25px 0; border-bottom: 1px solid var(--line); }
    .brand { font: 800 28px var(--mono); letter-spacing: -.08em; text-decoration: none; color: var(--text); }
    nav { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; font-size: 14px; }
    nav a { color: var(--muted); text-decoration: none; }
    nav a:hover { color: var(--accent); text-decoration: underline; }
    .theme { border: 0; padding: 0; background: transparent; font-size: 14px; color: var(--muted); }
    .skip { position: absolute; top: -100px; left: 16px; background: var(--bg); padding: 10px; z-index: 1; }
    .skip:focus { top: 8px; }
    .hero { padding: 72px 0 40px; max-width: 820px; }
    .eyebrow { text-transform: uppercase; letter-spacing: .12em; font: 12px/1.5 var(--mono); color: var(--accent); margin: 0 0 12px; }
    h1 { font-size: clamp(38px, 6vw, 68px); line-height: 1.05; letter-spacing: -.045em; margin: 0 0 22px; }
    h2 { font-size: 30px; line-height: 1.2; letter-spacing: -.025em; margin: 0 0 15px; }
    h3 { font-size: 18px; line-height: 1.4; margin: 0 0 8px; }
    p { margin: 0 0 18px; }
    .lead { color: var(--muted); font-size: 19px; }
    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin: 28px 0 16px; }
    .primary { display: inline-block; padding: 11px 22px; border-radius: 6px; background: var(--accent); color: var(--bg); font-weight: 650; text-decoration: none; }
    .small { font-size: 13px; color: var(--muted); }
    code, pre, kbd { font-family: var(--mono); }
    code { font-size: .88em; }
    pre { position: relative; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; line-height: 1.75; margin: 0; background: var(--panel); padding: 16px 18px; border-radius: 7px; }
    pre code { font-size: inherit; }
    .js pre[data-example] { padding-right: 76px; }
    .copy { position: absolute; top: 9px; right: 9px; font-size: 12px; padding: 3px 10px; border-radius: 4px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); }
    .copy:hover { color: var(--accent); }
    section { padding: 56px 0; border-top: 1px solid var(--line); }
    .section-lead { max-width: 680px; color: var(--muted); margin-bottom: 26px; }
    /* Slots for the captures of #356. Each says what goes in it until then. */
    .placeholder { display: grid; place-items: center; align-content: center; text-align: center; padding: 18px; border: 2px dashed var(--line); border-radius: 8px; background: var(--panel); color: var(--muted); font: 13px/1.5 var(--mono); }
    .capture { margin: 0 0 64px; }
    .capture .placeholder, .capture img { aspect-ratio: 16 / 9; width: 100%; height: auto; display: block; border-radius: 8px; }
    .capture button { margin-top: 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 5px; padding: 8px 18px; }
    .install-panels { display: grid; gap: 22px; }
    .install-panel { padding: 0; border: 0; }
    .install-panel h3 { font-size: 14px; color: var(--muted); font-weight: 600; }
    .install-panel p { font-size: 15px; }
    .js .install-panels { display: block; }
    .js .install-panel h3 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
    .tabs button { border: 1px solid var(--line); background: transparent; color: var(--muted); border-radius: 5px; padding: 5px 12px; font-size: 14px; }
    .tabs button[aria-selected="true"] { background: var(--accent); border-color: var(--accent); color: var(--bg); }
    .install-after { margin: 24px 0 12px; font-size: 15px; }
    .hero pre { max-width: 720px; }
    ul.section-lead { padding-left: 20px; }
    .features + .small { margin-top: 30px; }
    ul.section-lead li { margin-bottom: 6px; }
    .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px 30px; }
    .features .placeholder { aspect-ratio: 16 / 10; margin-bottom: 14px; }
    .features p { font-size: 15px; color: var(--muted); margin-bottom: 8px; }
    .features a { font-size: 14px; }
    .format-families { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px 30px; margin: 0; }
    .format-families div { border-top: 1px solid var(--line); padding-top: 12px; }
    .format-families dt { font-weight: 650; font-size: 15px; }
    .format-families dd { margin: 4px 0 0; color: var(--muted); font: 13px/1.7 var(--mono); }
    .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
    .paths > div { min-width: 0; }
    .paths pre { margin-bottom: 12px; }
    .compare { width: 100%; border-collapse: collapse; font-size: 15px; }
    .compare th, .compare td { text-align: left; vertical-align: top; padding: 12px 14px 12px 0; border-bottom: 1px solid var(--line); }
    .compare thead th { white-space: nowrap; }
    .compare .num { text-align: right; white-space: nowrap; }
    .compare td { color: var(--muted); }
    .version-list { list-style: none; margin: 18px 0; padding: 0; }
    .version-list li { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; border-bottom: 1px solid var(--line); padding: 10px 0; }
    .version-list a { font-family: var(--mono); font-size: 14px; }
    .version-list span { color: var(--muted); font-size: 12px; }
    .version-list time { margin-left: auto; font-size: 12px; color: var(--muted); }
    summary { color: var(--accent); }
    footer { border-top: 1px solid var(--line); padding: 25px 0 35px; display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; font-size: 13px; color: var(--muted); }
    [hidden] { display: none !important; }
    @media (max-width: 900px) { .features { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 640px) {
      .wrap { width: calc(100% - 32px); } nav { gap: 16px; }
      .hero { padding: 44px 0 28px; } .capture { margin-bottom: 40px; }
      .features, .paths, .format-families { grid-template-columns: 1fr; }
      section { padding: 38px 0; }
      .compare, .compare tbody, .compare tr, .compare th, .compare td { display: block; }
      .compare thead { display: none; }
      .compare tr { border-bottom: 1px solid var(--line); padding: 10px 0; }
      .compare th, .compare td { border: 0; padding: 2px 0; white-space: normal; }
      .compare td.num { text-align: left; }
      .compare td[data-label]::before { content: attr(data-label) ": "; }
      .version-list time { width: 100%; margin-left: 0; }
    }
  </style>
</head>
<body>
  {% set repo = 'https://github.com/derekwisong/datui' %}
  {% set docs = docs_path ~ '/' if docs_path else repo ~ '/tree/main/docs/' %}
  {% macro guide(path) -%}{{ docs ~ path ~ '.html' if docs_path else repo ~ '/blob/main/docs/' ~ path ~ '.md' }}{%- endmacro %}
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap">
    <header>
      <a class="brand" href="./" aria-label="datui home">datui</a>
      <nav aria-label="Main navigation">
        <a href="#install">Install</a>
        <a href="{{ docs }}">Docs</a>
        <a href="{{ repo }}">GitHub</a>
        <button class="theme" id="theme-toggle" hidden>Change theme</button>
      </nav>
    </header>
    <main id="main">
      <div class="hero">
        <p class="eyebrow">A terminal UI for tabular data</p>
        <h1>Explore tabular data in your terminal.</h1>
        <p class="lead">{{ format_count }} formats, from your disk, S3, GCS, Azure, HTTP(S), a pipe or Python. Query with SQL or q, chart, reshape and export.</p>
        <pre data-example="bash,network"><code>datui s3://noaa-ghcn-pds/parquet/by_year/YEAR=2024/   # 38M rows, no login</code></pre>
        <div class="actions">
          <a class="primary" href="#install">Install</a>
          <a href="{{ guide('getting-started/quick-start') }}">Quick start →</a>
        </div>
        <p class="small">Linux, macOS and Windows · One binary, built on Polars · MIT license · No telemetry</p>
      </div>

      <figure class="capture">
        {% if teaser %}
        <img id="teaser" src="{{ teaser.poster }}" data-poster="{{ teaser.poster }}" data-src="{{ teaser.gif }}" alt="datui opening public data, querying it and charting the result" width="1600" height="900">
        <button id="play-teaser" hidden aria-controls="teaser">Play</button>
        <noscript><a href="{{ teaser.gif }}">Watch the demo (GIF)</a></noscript>
        {% else %}
        <div class="placeholder" role="img" aria-label="Capture to come">CAPTURE PLACEHOLDER (#356)<br>Teaser GIF behind a static poster, with Play and Stop</div>
        {% endif %}
      </figure>

      <section id="install" aria-labelledby="install-title">
        <p class="eyebrow">Get started</p>
        <h2 id="install-title">Install</h2>
        <p class="section-lead">Every method installs the same <code>datui</code>. Check it with <code>datui --version</code>.</p>
{# generated: install #}
<div class="install-panels" id="install-panels">
  <section class="install-panel" id="install-script" data-label="Linux, macOS" data-os="linux macos">
    <h3>Linux, macOS</h3>
    <pre data-example="bash,install"><code>curl -fsSL https://raw.githubusercontent.com/derekwisong/datui/main/scripts/install/install.sh | sh</code></pre>
  </section>
  <section class="install-panel" id="install-winget" data-label="Windows, WinGet" data-os="windows">
    <h3>Windows, WinGet</h3>
    <pre data-example="powershell,install"><code>winget install derekwisong.datui</code></pre>
  </section>
  <section class="install-panel" id="install-brew" data-label="macOS, Homebrew" data-os="">
    <h3>macOS, Homebrew</h3>
    <pre data-example="bash,install"><code>brew tap derekwisong/datui &amp;&amp; brew trust derekwisong/datui &amp;&amp; brew install datui</code></pre>
  </section>
  <section class="install-panel" id="install-pip" data-label="Python, PyPI" data-os="">
    <h3>Python, PyPI</h3>
    <pre data-example="bash,install"><code>pip install datui</code></pre>
  </section>
  <section class="install-panel" id="install-cargo" data-label="Rust, crates.io" data-os="">
    <h3>Rust, crates.io</h3>
    <pre data-example="bash,install"><code>cargo install datui --locked</code></pre>
  </section>
  <section class="install-panel" id="install-aur" data-label="Arch Linux, AUR" data-os="">
    <h3>Arch Linux, AUR</h3>
    <pre data-example="bash,install"><code>yay -S datui-bin</code></pre>
  </section>
  <section class="install-panel" id="install-apt" data-label="Debian, Ubuntu" data-os="">
    <h3>Debian, Ubuntu</h3>
    <pre data-example="bash,install"><code>curl -fsSL https://derekwisong.github.io/datui-apt/public.key | sudo gpg --dearmor -o /usr/share/keyrings/datui-archive-keyring.gpg
echo &quot;deb [signed-by=/usr/share/keyrings/datui-archive-keyring.gpg] https://derekwisong.github.io/datui-apt/ ./&quot; | sudo tee /etc/apt/sources.list.d/datui.list
sudo apt update
sudo apt install datui</code></pre>
  </section>
  <section class="install-panel" id="install-binaries" data-label="Binaries" data-os="">
    <h3>Binaries</h3>
    <p>Linux (x86_64, arm64), macOS (Intel, Apple silicon) and Windows binaries, plus <code>.deb</code>, <code>.rpm</code> and Arch tarballs, are on the <a href="https://github.com/derekwisong/datui/releases/latest">latest release</a>.</p>
  </section>
</div>
{# end generated: install #}
        <p class="install-after">One binary; only <code>cargo install</code> needs Rust. <a href="{{ guide('getting-started/installation') }}">Installation guide</a>: user-only installs, RPMs, the manual page, shell completions, building from source · <a href="{{ repo }}/releases/latest">Latest release</a></p>
      </section>

      <section aria-labelledby="proof-title">
        <h2 id="proof-title">How it stays fast</h2>
        <ul class="section-lead">
          <li>Rust on Polars. Every table is a <code>LazyFrame</code> until it is drawn.</li>
          <li>Only the rows on screen and a lookahead buffer are collected. Sort, filter and query build on the lazy plan.</li>
          <li>A Parquet file in S3, GCS or Azure is read in place: footers for the schema and row count, then only the row groups the screen needs.</li>
          <li>The row count runs in the background; the table is usable before it is done.</li>
        </ul>
        <table class="compare">
          <thead><tr><th scope="col">Open</th><th scope="col" class="num">First rows</th><th scope="col" class="num">Exact row count</th></tr></thead>
          <tbody>
            <tr><th scope="row">CSV, 4,000,000 rows, 234 MB, local</th><td class="num" data-label="First rows">14 ms</td><td class="num" data-label="Exact row count">0.36 s</td></tr>
            <tr><th scope="row">Parquet, the same rows, 53 MB, local</th><td class="num" data-label="First rows">10 ms</td><td class="num" data-label="Exact row count">10 ms</td></tr>
            <tr><th scope="row">Text log, the same 234 MB as <code>.log</code>, local</th><td class="num" data-label="First rows">12 ms</td><td class="num" data-label="Exact row count">not measured</td></tr>
            <tr><th scope="row"><a href="https://registry.opendata.aws/noaa-ghcn/">NOAA GHCN-D</a> 2024, public S3: 137 Parquet files, 38,465,374 rows</th><td class="num" data-label="First rows">0.54 s</td><td class="num" data-label="Exact row count">0.52 s</td></tr>
          </tbody>
        </table>
        <p class="small">Time from launch, median of 5 runs (S3: 3, no cache, home network). Release build of 0.4.0-dev, Ryzen 7 9800X3D, Linux, warm page cache, 120×30 pseudo-terminal. The local files are <code>scripts/bench/startup.py generate DIR 4000000</code>. Piped input shows its first rows once 1,000 lines have arrived, sooner from a slower producer. <a href="{{ guide('reference/performance') }}">Performance</a> has more.</p>
      </section>

      <section aria-labelledby="features-title">
        <h2 id="features-title">What it does</h2>
        <div class="features">
          <div>
            <div class="placeholder" role="img" aria-label="Screenshot to come">STILL PLACEHOLDER (#356)<br>Formats</div>
            <h3>{{ format_count }} formats, and yours</h3>
            <p>From Parquet, CSV, Arrow and JSON to SQLite, GGUF, audio and flight logs. A TOML format spec describes your own binary or delimited format; any file opens in the hex view.</p>
            <a href="{{ guide('formats/index') }}">Formats →</a> · <a href="{{ guide('formats/format-specs') }}">Format specs →</a>
          </div>
          <div>
            <div class="placeholder" role="img" aria-label="Screenshot to come">STILL PLACEHOLDER (#356)<br>Home screen, cloud sources</div>
            <h3>Cloud or home</h3>
            <p>Local files, directories, globs, S3, GCS, Azure and HTTP(S). Hive-partitioned folders read as one table. The home screen lists your catalogs, the cloud accounts it finds logins for, and Example datasets that need no login.</p>
            <a href="{{ guide('user-guide/home-screen') }}">Home screen →</a> · <a href="{{ guide('user-guide/remote-data') }}">Cloud storage →</a>
          </div>
          <div>
            <div class="placeholder" role="img" aria-label="Screenshot to come">STILL PLACEHOLDER (#356)<br>The command line</div>
            <h3>Query and find</h3>
            <p><kbd>:</kbd> runs SQL or q; <kbd>/</kbd> finds text, a regex or letters in order. <kbd>[</kbd> <kbd>]</kbd> sort by the cursor's column, <kbd>+</kbd> <kbd>-</kbd> keep or drop its value, and <kbd>v</kbd> saves the steps as a view for the next file.</p>
            <a href="{{ guide('user-guide/querying-data') }}">Query data →</a>
          </div>
          <div>
            <div class="placeholder" role="img" aria-label="Screenshot to come">STILL PLACEHOLDER (#356)<br>A chart</div>
            <h3>Chart</h3>
            <p><kbd>c</kbd> charts the column under the cursor: line, scatter, bar, histogram, box, KDE or heatmap, of the rows the query and filters leave. <kbd>e</kbd> exports it to PNG, SVG or PDF.</p>
            <a href="{{ guide('user-guide/charting') }}">Charts →</a>
          </div>
          <div>
            <div class="placeholder" role="img" aria-label="Screenshot to come">STILL PLACEHOLDER (#356)<br>Pivot, column types</div>
            <h3>Reshape and retype</h3>
            <p>Pivot or melt (<kbd>p</kbd>) with a live preview. Change a column's type from the Info panel's Schema tab or a right click on a cell.</p>
            <a href="{{ guide('user-guide/reshaping') }}">Reshaping →</a> · <a href="{{ guide('user-guide/dataset-info') }}">Column types →</a>
          </div>
          <div>
            <div class="placeholder" role="img" aria-label="Screenshot to come">STILL PLACEHOLDER (#356)<br>A pipe, or Python</div>
            <h3>Pipes and Python</h3>
            <p>Pipe a command's output in, follow a file as it grows, or call <code>datui.view()</code> on a Polars frame.</p>
            <a href="{{ guide('user-guide/pipes-and-follow') }}">Pipes →</a> · <a href="{{ guide('user-guide/python-module') }}">Python →</a>
          </div>
        </div>
        <p class="small">Also: catalogs of your own datasets with a Documentation view (<kbd>Ctrl+E</kbd>), themes (<code>datui theme list</code>), the mouse, and copy over SSH through OSC 52. <a href="{{ guide('reference/keyboard-shortcuts') }}">Every key</a></p>
      </section>

      <section aria-labelledby="formats-title">
        <h2 id="formats-title">{{ format_count }} formats</h2>
        <p class="section-lead">Each one reads from disk, HTTP(S) or a bucket. <a href="{{ guide('formats/index') }}">The formats table</a> says which read lazily and which read compressed.</p>
{# generated: formats #}
<dl class="format-families">
  <div><dt><a href="{{ guide('formats/columnar-and-json') }}">Columnar and JSON</a></dt><dd>Parquet · JSON · NDJSON · Arrow IPC · Avro · ORC · Excel</dd></div>
  <div><dt><a href="{{ guide('formats/delimited-text') }}">Delimited text</a></dt><dd>CSV · TSV · PSV · plain text</dd></div>
  <div><dt><a href="{{ guide('formats/model-files') }}">Model files</a></dt><dd>SafeTensors · GGUF</dd></div>
  <div><dt><a href="{{ guide('formats/signals-and-logs') }}">Signals and logs</a></dt><dd>NMEA · GPX · WAV/AIFF audio · MIDI · VCD · FIX · SDF · ELF · ULog · DataFlash · candump · systemd journal</dd></div>
  <div><dt><a href="{{ guide('formats/databases-and-arrays') }}">Databases and arrays</a></dt><dd>SQLite · NumPy</dd></div>
  <div><dt><a href="{{ guide('formats/format-specs') }}">Format specs</a></dt><dd>Your own binary formats, described in TOML</dd></div>
</dl>
{# end generated: formats #}
      </section>

      <section aria-labelledby="try-title">
        <h2 id="try-title">Try it</h2>
        <div class="paths">
          <div>
            <h3>In your terminal</h3>
            <pre data-example="bash,network"><code>datui     # home screen: your files, and Example datasets to open with no login
datui https://vincentarelbundock.github.io/Rdatasets/csv/palmerpenguins/penguins.csv</code></pre>
            <pre data-example="bash"><code>printf 'id,amount\n1,9.50\n2,3.25\n' | datui</code></pre>
            <p class="small">Press <kbd>?</kbd> for the keys on any screen; <kbd>Ctrl+Q</kbd> quits. <a href="{{ guide('getting-started/quick-start') }}">Quick start</a> · <a href="{{ guide('reference/keyboard-shortcuts') }}">Keys</a></p>
          </div>
          <div>
            <h3>From Python</h3>
            <pre data-example="python,network"><code>import datui
import polars as pl

url = "https://vincentarelbundock.github.io/Rdatasets/csv/palmerpenguins/penguins.csv"
datui.view(pl.scan_csv(url))</code></pre>
            <p class="small"><code>pip install datui</code> installs the command and the module. <a href="{{ guide('user-guide/python-module') }}">Use datui from Python</a></p>
          </div>
        </div>
      </section>

      <section aria-labelledby="not-title">
        <h2 id="not-title">What it is not</h2>
        <ul class="section-lead">
          <li>An editor: cells cannot be changed, and datui does not write to the files it opens unless you export over one. Results leave as an export or a copy.</li>
          <li>A service: no telemetry, no update check. datui connects only to the data and the cloud accounts you open or browse.</li>
        </ul>
      </section>

      <section id="versions" aria-labelledby="docs-title">
        <h2 id="docs-title">Documentation</h2>
        <p><a href="{{ docs }}">Read {% if has_stable %}the latest release's{% else %}the development{% endif %} docs</a> · <a href="{{ guide('reference/keyboard-shortcuts') }}">Keys</a> · <a href="{{ guide('reference/query-syntax') }}">Query syntax</a> · <a href="{{ guide('reference/command-line-options') }}">Command line</a></p>
        {% if recent_versions %}
        <ul class="version-list">
          {% for version in recent_versions %}
          <li><a href="{{ version.path }}/">{{ version.name }}</a><span>{% if version.is_latest_stable %}Latest release{% elif version.is_development %}Development{% endif %}</span><time>{{ version.date_str }}</time></li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if older_versions %}
        <details><summary>Older releases</summary><ul class="version-list">
          {% for version in older_versions %}
          <li><a href="{{ version.path }}/">{{ version.name }}</a><time>{{ version.date_str }}</time></li>
          {% endfor %}
        </ul></details>
        {% endif %}
      </section>
    </main>
    <footer>
      <span><a href="{{ docs }}">Docs</a> · <a href="{{ repo }}">GitHub</a> · <a href="{{ repo }}/releases">Releases</a> · <a href="{{ repo }}/issues">Issues</a> · <a href="{{ repo }}/blob/main/LICENSE">MIT license</a></span>
      <span>Example data: <a href="https://allisonhorst.github.io/palmerpenguins/">Palmer penguins</a> (CC0; Horst, Hill and Gorman) · <a href="https://registry.opendata.aws/noaa-ghcn/">NOAA GHCN-D</a></span>
    </footer>
  </div>
  <script>
    const toggle = document.getElementById('theme-toggle');
    const dark = () => document.documentElement.dataset.theme
      ? document.documentElement.dataset.theme === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    const updateLabel = () => { toggle.textContent = dark() ? 'Light theme' : 'Dark theme'; };
    toggle.hidden = false;
    updateLabel();
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateLabel);
    toggle.addEventListener('click', () => {
      const theme = dark() ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('datui-theme', theme); } catch (_) { /* The toggle still works for this visit. */ }
      updateLabel();
    });

    // Install: tabs, opened on the visitor's system. Without this script every panel shows.
    const panels = [...document.querySelectorAll('.install-panel')];
    if (panels.length) {
      const platform = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent;
      const os = /win/i.test(platform) ? 'windows' : /mac|iphone|ipad/i.test(platform) ? 'macos' : 'linux';
      const list = document.createElement('div');
      list.className = 'tabs';
      list.setAttribute('role', 'tablist');
      list.setAttribute('aria-label', 'Install with');
      const tabs = panels.map((panel) => {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.id = 'tab-' + panel.id;
        tab.textContent = panel.dataset.label;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panel.id);
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
        list.appendChild(tab);
        return tab;
      });
      const show = (index, focus) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
          panels[i].hidden = i !== index;
        });
        if (focus) tabs[index].focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => show(i, false));
        tab.addEventListener('keydown', (e) => {
          const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
          if (step) { e.preventDefault(); show((i + step + tabs.length) % tabs.length, true); }
        });
      });
      panels[0].parentNode.insertBefore(list, panels[0]);
      const first = panels.findIndex((p) => p.dataset.os.split(' ').includes(os));
      show(first < 0 ? 0 : first, false);
    }

    // A copy button on every command.
    if (navigator.clipboard) {
      document.querySelectorAll('pre[data-example]').forEach((pre) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy the command');
        button.addEventListener('click', () => {
          navigator.clipboard.writeText(pre.querySelector('code').textContent).then(() => {
            button.textContent = 'Copied';
            setTimeout(() => { button.textContent = 'Copy'; }, 1500);
          });
        });
        pre.appendChild(button);
      });
    }

    const play = document.getElementById('play-teaser');
    if (play) {
      const teaser = document.getElementById('teaser');
      play.hidden = false;
      play.addEventListener('click', () => {
        const playing = teaser.getAttribute('src') === teaser.dataset.src;
        teaser.src = playing ? teaser.dataset.poster : teaser.dataset.src;
        play.textContent = playing ? 'Play' : 'Stop';
      });
    }
  </script>
</body>
</html>
