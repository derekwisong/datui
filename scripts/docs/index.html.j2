<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Explore tabular data in your terminal. Open local and cloud files, query with SQL, make charts, and export the result with datui.">
  <meta name="theme-color" content="#1a1b26">
  <title>datui — Explore data in your terminal</title>
  <script>
    try {
      const theme = localStorage.getItem('datui-theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    } catch (_) { /* System colors still work when storage is unavailable. */ }
  </script>
  <style>
    :root {
      color-scheme: light;
      --bg: #f7f8fc; --panel: #edf0f7; --text: #252b42; --muted: #57617b;
      --accent: #186183; --line: #d6dce8; --code: #1a1b26; --code-text: #c0caf5;
      --mono: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #1a1b26; --panel: #202334; --text: #c0caf5; --muted: #a9b1d6;
      --accent: #7dcfff; --line: #373d55;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        color-scheme: dark;
        --bg: #1a1b26; --panel: #202334; --text: #c0caf5; --muted: #a9b1d6;
        --accent: #7dcfff; --line: #373d55;
      }
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.65 system-ui, sans-serif; }
    a { color: var(--accent); text-underline-offset: .2em; }
    a:hover { text-decoration-thickness: 2px; }
    :focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; }
    button, summary { cursor: pointer; }
    button { font: inherit; color: inherit; }
    .wrap { width: min(1120px, 100% - 48px); margin-inline: auto; }
    header { display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; align-items: center; padding: 25px 0; border-bottom: 1px solid var(--line); }
    .brand { font: 800 28px var(--mono); letter-spacing: -.08em; text-decoration: none; color: var(--text); }
    nav { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; font-size: 14px; }
    nav a { color: var(--muted); text-decoration: none; }
    nav a:hover { color: var(--accent); text-decoration: underline; }
    .theme { border: 0; padding: 0; background: transparent; font-size: 14px; color: var(--muted); }
    .skip { position: absolute; top: -100px; left: 16px; background: var(--bg); padding: 10px; z-index: 1; }
    .skip:focus { top: 8px; }
    .hero { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: center; padding: 78px 0 65px; }
    .eyebrow { text-transform: uppercase; letter-spacing: .12em; font: 12px/1.5 var(--mono); color: var(--accent); }
    h1 { font-size: clamp(38px, 5vw, 62px); line-height: 1.08; letter-spacing: -.05em; margin: 18px 0 22px; }
    h2 { font-size: 30px; line-height: 1.2; letter-spacing: -.025em; margin: 0 0 15px; }
    h3 { font-size: 19px; line-height: 1.4; margin: 0 0 10px; }
    p { margin: 0 0 18px; }
    .lead { color: var(--muted); font-size: 19px; }
    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin: 27px 0 18px; }
    .primary { display: inline-block; padding: 10px 19px; border-radius: 5px; background: var(--accent); color: var(--bg); font-weight: 650; text-decoration: none; }
    .small { font-size: 13px; color: var(--muted); }
    code, pre, kbd { font-family: var(--mono); }
    code { font-size: .88em; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; line-height: 1.8; margin: 0; }
    .terminal { margin: 0; overflow: hidden; background: var(--code); color: var(--code-text); border: 1px solid #373d55; border-radius: 10px; }
    .terminal figcaption { padding: 11px 20px; border-bottom: 1px solid #373d55; font: 12px var(--mono); color: #a9b1d6; }
    .terminal-body { padding: 25px 23px; }
    .terminal .prompt { color: #7dcfff; }
    .terminal .query { margin: 25px 0 18px; color: #9ece6a; }
    .terminal table { font: 13px/2 var(--mono); width: 100%; border-collapse: collapse; }
    .terminal th { text-align: left; color: #a9b1d6; font-weight: 400; border-bottom: 1px solid #373d55; }
    .terminal td:last-child, .terminal th:last-child { text-align: right; }
    .terminal .note { color: #a9b1d6; font: 11px/1.6 var(--mono); margin: 18px 0 0; }
    .formats { color: var(--muted); font: 12px/2 var(--mono); border-block: 1px solid var(--line); padding: 16px 0; }
    section { padding: 60px 0; }
    .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 38px; }
    .features p { font-size: 15px; color: var(--muted); }
    .features a { font-size: 14px; }
    .section-lead { max-width: 650px; color: var(--muted); margin-bottom: 28px; }
    .install { border-block: 1px solid var(--line); }
    .install-command { padding: 20px 24px; border-radius: 7px; background: var(--panel); margin-bottom: 22px; }
    .install-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 35px; margin: 25px 0; }
    .install-option { padding: 14px 0; border-top: 1px solid var(--line); min-width: 0; }
    .install-option strong { display: block; font-size: 14px; margin-bottom: 6px; }
    .install-option code { display: block; overflow-wrap: anywhere; font-size: 12px; }
    .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 35px; }
    .paths pre { background: var(--panel); padding: 21px; border-radius: 7px; }
    .demo { padding: 18px 0 0; }
    .demo img { display: block; width: 100%; height: auto; margin-top: 18px; border-radius: 7px; }
    .demo button { background: var(--panel); border: 0; border-radius: 5px; padding: 10px 18px; }
    .versions { border-top: 1px solid var(--line); }
    .version-list { list-style: none; margin: 18px 0; padding: 0; }
    .version-list li { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; border-bottom: 1px solid var(--line); padding: 10px 0; }
    .version-list a { font-family: var(--mono); font-size: 14px; }
    .version-list span { color: var(--muted); font-size: 12px; }
    .version-list time { margin-left: auto; font-size: 12px; color: var(--muted); }
    summary { color: var(--accent); }
    footer { border-top: 1px solid var(--line); padding: 25px 0 35px; display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; font-size: 13px; color: var(--muted); }
    [hidden] { display: none !important; }
    @media (max-width: 850px) { .hero { grid-template-columns: 1fr; gap: 32px; padding-top: 45px; } .features { gap: 25px; } }
    @media (max-width: 600px) {
      .wrap { width: calc(100% - 32px); } nav { gap: 16px; }
      .features, .install-grid, .paths { grid-template-columns: 1fr; }
      section { padding: 38px 0; } .hero { padding-bottom: 35px; }
      .terminal-body { padding: 20px 16px; } .version-list time { width: 100%; margin-left: 0; }
    }
  </style>
</head>
<body>
  {% set repo = 'https://github.com/derekwisong/datui' %}
  {% set docs = docs_path ~ '/' if docs_path else repo ~ '/tree/main/docs/' %}
  {% macro guide(path) -%}{{ docs ~ path ~ '.html' if docs_path else repo ~ '/blob/main/docs/' ~ path ~ '.md' }}{%- endmacro %}
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap">
    <header>
      <a class="brand" href="./" aria-label="datui home">datui</a>
      <nav aria-label="Main navigation">
        <a href="#install">Install</a>
        <a href="{{ docs }}">Docs</a>
        <a href="{{ repo }}">GitHub</a>
        <button class="theme" id="theme-toggle" hidden>Change theme</button>
      </nav>
    </header>
    <main id="main">
      <div class="hero">
        <div>
          <p class="eyebrow">A terminal UI for tabular data</p>
          <h1>Tabular data<br>in your terminal.</h1>
          <p class="lead">Browse local files and cloud datasets. Run SQL, filter rows, make charts and export results.</p>
          <div class="actions">
            <a class="primary" href="#install">Install datui</a>
            <a href="{{ guide('getting-started/quick-start') }}">Try the quick start →</a>
          </div>
          <p class="small">Linux, macOS and Windows · Open source · MIT licensed</p>
        </div>
        <figure class="terminal">
          <figcaption>Example: average body mass by species</figcaption>
          <div class="terminal-body">
            <pre><span class="prompt">$</span> datui</pre>
            <pre class="query">SELECT species, AVG(body_mass_g) AS mean_mass_g
FROM df GROUP BY species
ORDER BY mean_mass_g DESC</pre>
            <table aria-label="Mean penguin body mass by species, rounded to one decimal">
              <thead><tr><th>species</th><th>mean_mass_g</th></tr></thead>
              <tbody><tr><td>Gentoo</td><td>5,076.0</td></tr><tr><td>Chinstrap</td><td>3,733.1</td></tr><tr><td>Adelie</td><td>3,700.7</td></tr></tbody>
            </table>
            <p class="note">Public datasets › Palmer penguins · 344 records · means ignore nulls<br>Example result, rounded to one decimal.</p>
          </div>
        </figure>
      </div>
      <p class="formats">Parquet · CSV / TSV / PSV · JSON / JSONL · Arrow / Feather · Avro · ORC · Excel</p>
      <section aria-label="What you can do">
        <div class="features">
          <div><h2>Find your data</h2><p>Browse recent files, directories and cloud buckets. Open S3, GCS, Azure or HTTP URLs, or start from the built-in catalog of public datasets that need no login.</p><a href="{{ guide('user-guide/loading-data') }}">Files and cloud storage →</a></div>
          <div><h2>Query and analyze</h2><p>Use SQL, text search or short q-style queries. Sort and filter rows, inspect statistics, and chart the result.</p><a href="{{ guide('user-guide/querying-data') }}">Querying and search →</a></div>
          <div><h2>Save and reuse</h2><p>Copy a table into a note. Export data or a chart. Save a view to repeat the same steps on the next file.</p><a href="{{ guide('user-guide/exporting-data') }}">Exporting data →</a></div>
        </div>
        {% if demo_path %}
        <div class="demo">
          <p class="small">Watch a query narrow public US baby-name data to one name's history.</p>
          <button id="play-demo" hidden aria-controls="query-demo">Play the query demo</button>
          <img id="query-demo" data-src="{{ demo_path }}" alt="A datui query selects year, name, count and rank for Derek from public US baby-name data" hidden>
          <noscript><a href="{{ demo_path }}">Open the query demo (GIF)</a></noscript>
        </div>
        {% endif %}
      </section>
      <section class="install" id="install">
        <p class="eyebrow">Get started</p>
        <h2>Install datui</h2>
        <p class="section-lead">On Linux or macOS, the installer picks the release for your machine. Package-manager commands are below.</p>
        <div class="install-command"><pre><code>curl -fsSL https://raw.githubusercontent.com/derekwisong/datui/main/scripts/install/install.sh | sh</code></pre></div>
        <div class="install-grid">
          <div class="install-option"><strong>macOS · Homebrew</strong><code>brew tap derekwisong/datui &amp;&amp; brew trust derekwisong/datui &amp;&amp; brew install datui</code></div>
          <div class="install-option"><strong>Windows · WinGet</strong><code>winget install derekwisong.datui</code></div>
          <div class="install-option"><strong>Python · command and module</strong><code>pip install datui</code></div>
          <div class="install-option"><strong>Rust · Cargo</strong><code>cargo install datui --locked</code></div>
        </div>
        <p><a href="{{ guide('getting-started/installation') }}">All installation methods</a> · <a href="{{ repo }}/releases/latest">Download a binary</a></p>
      </section>
      <section>
        <h2>Start with a file or a DataFrame</h2>
        <p class="section-lead">Use the same UI from your shell or Python. Press <kbd>?</kbd> for help on the screen you're using.</p>
        <div class="paths">
          <div><h3>In your terminal</h3><pre><code>datui  # home screen and public datasets
datui sales.parquet
datui ./exports/
datui s3://noaa-ghcn-pds/parquet/by_year/YEAR=2024/</code></pre><p><a href="{{ guide('getting-started/quick-start') }}">Open → query → chart → export</a></p></div>
          <div><h3>From Python</h3><pre><code>import datui
import polars as pl

url = "https://vincentarelbundock.github.io/Rdatasets/csv/palmerpenguins/penguins.csv"
datui.view(pl.scan_csv(url))</code></pre><p><a href="{{ guide('user-guide/python-module') }}">Explore a frame and capture your view</a></p></div>
        </div>
        <p class="small">Powered by Polars. Scanned formats load rows as needed; sorting, aggregation and analysis may read the full input. <a href="{{ guide('advanced/performance-tips') }}">Working with large datasets</a>.</p>
      </section>
      <section class="versions" id="versions">
        <h2>Documentation</h2>
        <p><a href="{{ docs }}">Read {% if has_stable %}the latest release{% else %}the development{% endif %} docs</a> · <a href="{{ guide('reference/keyboard-shortcuts') }}">Keyboard shortcuts</a> · <a href="{{ guide('reference/query-syntax') }}">Query syntax</a></p>
        {% if recent_versions %}
        <ul class="version-list">
          {% for version in recent_versions %}
          <li><a href="{{ version.path }}/">{{ version.name }}</a><span>{% if version.is_latest_stable %}Latest release{% elif version.is_development %}Development{% endif %}</span><time>{{ version.date_str }}</time></li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if older_versions %}
        <details><summary>Older releases</summary><ul class="version-list">
          {% for version in older_versions %}
          <li><a href="{{ version.path }}/">{{ version.name }}</a><time>{{ version.date_str }}</time></li>
          {% endfor %}
        </ul></details>
        {% endif %}
      </section>
    </main>
    <footer><span>datui · <a href="{{ repo }}/blob/main/LICENSE">MIT license</a></span><span><a href="{{ repo }}/issues">Report an issue</a> · <a href="{{ guide('for-developers') }}">Contribute</a> · <a href="https://allisonhorst.github.io/palmerpenguins/">Example data: Palmer penguins (CC0; Horst, Hill and Gorman)</a></span></footer>
  </div>
  <script>
    const toggle = document.getElementById('theme-toggle');
    const dark = () => document.documentElement.dataset.theme
      ? document.documentElement.dataset.theme === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    const updateLabel = () => { toggle.textContent = dark() ? 'Light theme' : 'Dark theme'; };
    toggle.hidden = false;
    updateLabel();
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateLabel);
    toggle.addEventListener('click', () => {
      const theme = dark() ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('datui-theme', theme); } catch (_) { /* The toggle still works for this visit. */ }
      updateLabel();
    });
    const play = document.getElementById('play-demo');
    if (play) {
      const demo = document.getElementById('query-demo');
      play.hidden = false;
      play.addEventListener('click', () => {
        if (demo.hidden) {
          demo.src = demo.dataset.src;
          demo.hidden = false;
          play.textContent = 'Stop the demo';
        } else {
          demo.hidden = true;
          demo.removeAttribute('src');
          play.textContent = 'Play the query demo';
        }
      });
    }
  </script>
</body>
</html>
