Output demos/15-cloud-home-browse.gif
Set FontSize 14
Set Width 1200
Set Height 800
Set TypingSpeed 25ms
# DO NOT DELETE - HEADER ABOVE

# Browse-first variation: linger on the public catalog and its details.
Hide
Type "cd /tmp/datui-demo/data"
Enter
Type "clear"
Enter
Show

Type "datui"
Enter
Sleep 3s
Type "public"
Sleep 1.5s
Enter
Sleep 2s

Down
Sleep 1.2s
Down
Sleep 1.2s
Down
Sleep 1.2s
Down
Sleep 1.2s
Down
Sleep 1.8s

# Open BigQuery sample data and descend to a real cloud object.
Enter
Sleep 6s
Type "states"
Sleep 1.2s
Enter
Sleep 5s
Type "parquet"
Sleep 2s

Ctrl+U
Sleep 1s
Backspace
Sleep 2s
Backspace
Sleep 2s
Backspace
Sleep 2s

Ctrl+Q
